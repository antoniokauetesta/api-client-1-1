generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Pessoa {
  id    Int    @id @default(autoincrement())
  nome  String
  cpf   String @unique
  email Email?
}

model Email {
  id       Int    @id @default(autoincrement())
  email    String @unique
  pessoaId Int    @unique

  pessoa Pessoa @relation(fields: [pessoaId], references: [id])
}